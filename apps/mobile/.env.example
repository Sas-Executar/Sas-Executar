# Chave pública do frontend nativo; nunca use CLERK_SECRET_KEY no aplicativo.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_substitua_no_ambiente

# URL HTTPS alcançável pelo simulador/dispositivo, sem barra final.
EXPO_PUBLIC_EXECUTAR_API_URL=https://app.exemplo.com

# Identificadores de build podem ser sobrescritos por ambiente EAS.
EXECUTAR_IOS_BUNDLE_IDENTIFIER=com.sasexecutar.executar
EXECUTAR_ANDROID_PACKAGE=com.sasexecutar.executar
