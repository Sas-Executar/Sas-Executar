# EXECUTAR · configuração pública de produção
#
# Este arquivo é versionado e carregado pelo Next.js durante o build de produção.
# Somente variáveis NEXT_PUBLIC_ sem segredo podem ser adicionadas aqui.
# Credenciais de servidor devem ser cadastradas no painel da Vercel.

NEXT_PUBLIC_APP_URL="https://$VERCEL_URL"
NEXT_PUBLIC_WEB_URL="https://$VERCEL_URL"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"
