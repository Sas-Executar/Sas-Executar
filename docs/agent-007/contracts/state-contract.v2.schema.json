{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://executar.app/contracts/agent-007/state-contract.v2.schema.json",
  "title": "EXECUTAR Agent-007 State Contract v2",
  "description": "Contrato proposto para o estado operacional canônico. Estados de entrega são derivados; projeções não podem escrever neste objeto.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "organizationId",
    "projects",
    "activeProjectId",
    "done",
    "focus",
    "evidence",
    "started",
    "collaboration",
    "events",
    "revision"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "organizationId": { "$ref": "#/$defs/nonEmptyId" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/project" }
    },
    "activeProjectId": { "$ref": "#/$defs/nonEmptyId" },
    "done": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/deliveryId" }
    },
    "focus": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/deliveryId" }
      ]
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "started": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "collaboration": { "$ref": "#/$defs/collaboration" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "nonEmptyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "deliveryId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "deliveryState": {
      "type": "string",
      "enum": [
        "BACKLOG_VALIDATED",
        "READY",
        "DOING",
        "VERIFY",
        "DONE",
        "BLOCKED"
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "front", "date", "mins", "deps", "stage"],
      "properties": {
        "id": { "$ref": "#/$defs/deliveryId" },
        "title": { "type": "string", "minLength": 1 },
        "front": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^[0-9]{2}/[0-9]{2}$" },
        "mins": { "type": "integer", "minimum": 1 },
        "deps": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/deliveryId" }
        },
        "stage": { "type": "integer", "minimum": 1, "maximum": 4 },
        "dod": { "type": "string", "minLength": 1 }
      }
    },
    "completionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireDod", "requireEvidence", "requireVerification", "requireHumanApproval"],
      "properties": {
        "requireDod": { "type": "boolean" },
        "requireEvidence": { "type": "boolean" },
        "requireVerification": { "type": "boolean" },
        "requireHumanApproval": { "type": "boolean" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tasks", "dailyCapacityMinutes", "completionPolicy"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "name": { "type": "string", "minLength": 1 },
        "tasks": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/delivery" }
        },
        "dailyCapacityMinutes": {
          "type": "integer",
          "minimum": 15,
          "maximum": 1440
        },
        "completionPolicy": { "$ref": "#/$defs/completionPolicy" }
      }
    },
    "evidenceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "type", "storagePath"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1, "maximum": 2500000 },
        "type": { "type": "string", "minLength": 1 },
        "storagePath": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "note", "url", "verified", "createdAt"],
      "properties": {
        "taskId": { "$ref": "#/$defs/deliveryId" },
        "note": { "type": "string" },
        "url": { "type": "string" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "authorUserId": { "$ref": "#/$defs/nonEmptyId" },
        "file": { "$ref": "#/$defs/evidenceFile" }
      },
      "anyOf": [
        { "properties": { "note": { "minLength": 1 } } },
        { "properties": { "url": { "minLength": 1 } } },
        { "required": ["file"] }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "projectId", "revision", "action", "taskId", "at"],
      "properties": {
        "organizationId": { "$ref": "#/$defs/nonEmptyId" },
        "projectId": { "$ref": "#/$defs/nonEmptyId" },
        "revision": { "type": "integer", "minimum": 1 },
        "action": { "type": "string", "minLength": 1 },
        "taskId": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/deliveryId" }
          ]
        },
        "at": { "type": "string", "format": "date-time" },
        "actor": { "enum": ["humano", "copiloto", "sistema"] },
        "userId": { "$ref": "#/$defs/nonEmptyId" },
        "tool": { "type": "string", "minLength": 1 },
        "humanApproved": { "type": "boolean" },
        "fingerprint": { "type": "string", "minLength": 1 },
        "runId": { "$ref": "#/$defs/nonEmptyId" },
        "operationId": { "$ref": "#/$defs/nonEmptyId" }
      }
    },
    "collaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presence", "comments", "notificationReads"],
      "properties": {
        "presence": { "type": "array", "items": { "type": "object" } },
        "comments": { "type": "array", "items": { "type": "object" } },
        "notificationReads": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "x-executar-invariants": [
    "activeProjectId referencia um projeto da mesma organizationId",
    "focus referencia no máximo uma entrega liberada do projeto ativo",
    "dependências existem no mesmo projeto e o grafo é acíclico",
    "estado de entrega é derivado e nunca aceito de projeções externas",
    "DONE exige a completionPolicy do projeto, evidência aplicável e aprovação humana quando configurada",
    "revision cresce monotonicamente e eventos novos carregam a revisão correspondente",
    "organizationId, projectId, expectedRevision e aprovação são resolvidos no servidor"
  ]
}
