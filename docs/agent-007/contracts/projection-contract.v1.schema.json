{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://executar.app/contracts/agent-007/projection-contract.v1.schema.json",
  "title": "EXECUTAR Agent-007 Projection Contract v1",
  "description": "Payload somente leitura entre o estado canônico e renderers EXECUTAR.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectionId",
    "organizationId",
    "projectId",
    "sourceRevision",
    "kind",
    "generatedAt",
    "locale",
    "project",
    "progress",
    "focus",
    "ready",
    "blocked",
    "slots"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "projectionId": { "$ref": "#/$defs/nonEmptyString" },
    "organizationId": { "$ref": "#/$defs/nonEmptyString" },
    "projectId": { "$ref": "#/$defs/nonEmptyString" },
    "sourceRevision": { "type": "integer", "minimum": 0 },
    "kind": {
      "enum": ["APP_DASHBOARD", "MAPA_OS", "PRISMA", "WORKBOOK", "SHOWROOM"]
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "locale": { "const": "pt-BR" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "variant"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "variant": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completedMinutes", "totalMinutes", "percentage", "completedCount", "totalCount"],
      "properties": {
        "completedMinutes": { "type": "integer", "minimum": 0 },
        "totalMinutes": { "type": "integer", "minimum": 0 },
        "percentage": { "type": "integer", "minimum": 0, "maximum": 100 },
        "completedCount": { "type": "integer", "minimum": 0 },
        "totalCount": { "type": "integer", "minimum": 0 }
      }
    },
    "focus": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/taskProjection" }
      ]
    },
    "ready": {
      "type": "array",
      "items": { "$ref": "#/$defs/taskProjection" }
    },
    "blocked": {
      "type": "array",
      "items": { "$ref": "#/$defs/blockedTaskProjection" }
    },
    "slots": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" },
          { "type": "array", "items": { "type": ["string", "number", "boolean", "null"] } }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mediaType", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/nonEmptyString" },
          "mediaType": { "$ref": "#/$defs/nonEmptyString" },
          "label": { "$ref": "#/$defs/nonEmptyString" },
          "href": { "type": "string" },
          "qrPayload": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 240 },
    "deliveryState": {
      "enum": ["BACKLOG_VALIDATED", "READY", "DOING", "VERIFY", "DONE", "BLOCKED"]
    },
    "taskProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "front", "date", "mins", "stage", "state", "dod", "evidenceCount"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "front": { "$ref": "#/$defs/nonEmptyString" },
        "date": { "type": "string" },
        "mins": { "type": "integer", "minimum": 1 },
        "stage": { "type": "integer", "minimum": 1 },
        "state": { "$ref": "#/$defs/deliveryState" },
        "dod": { "type": ["string", "null"] },
        "evidenceCount": { "type": "integer", "minimum": 0 },
        "pendingDependencyIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "blockedTaskProjection": {
      "allOf": [
        { "$ref": "#/$defs/taskProjection" },
        {
          "type": "object",
          "required": ["pendingDependencyIds"],
          "properties": {
            "pendingDependencyIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      ]
    }
  },
  "x-executar-invariants": [
    "payload é somente leitura e não contém credenciais nem porta de escrita",
    "sourceRevision identifica uma revisão canônica confirmada",
    "filas, bloqueios e progresso são derivados do mesmo estado",
    "evidências expõem apenas contagem/metadados necessários, nunca bytes ou base64",
    "template e slots não podem promover ou recalcular estados",
    "overrides visuais seguem tokens globais, variante nomeada e override auditado"
  ]
}
